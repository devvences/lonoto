# Server-side OMDb key for the movie lookup proxy.
# Copy this file to .env.local and replace the value.
# Get a free key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Optional. CloudFront uses this to prove a request came through the app.
# The deploy script generates one automatically; the local dev server does not
# need it.
# MOVIE_ORIGIN_SECRET=change-me-to-a-long-random-value
